<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Shown while the process starts; removed on Flutter's first frame.
         The app is light-only, so there is no values-night variant. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Window colour behind the Flutter UI. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/paper</item>
    </style>
</resources>
